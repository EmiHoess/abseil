@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(seil_with_ceres "@seil_enable_ceres@")
set(seil_with_cuda "@seil_enable_cuda@")

if(seil_with_ceres)
  find_dependency(Ceres CONFIG REQUIRED)
endif()

if(seil_with_cuda)
  find_dependency(CUDAToolkit REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/seilTargets.cmake")
check_required_components(seil)
